{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunCommandsOnGroundworkServer",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-1:699191579533:instance/*",
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
      ],
      "Condition": {"StringEqualsIfExists": {"ssm:resourceTag/project": "groundwork"}}
    },
    {
      "Sid": "ReadCommandResultsAndInstances",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations", "ssm:DescribeInstanceInformation",
                 "ec2:DescribeInstances"],
      "Resource": "*"
    },
    {
      "Sid": "ReadGroundworkStack",
      "Effect": "Allow",
      "Action": ["cloudformation:DescribeStacks", "cloudformation:DescribeStackEvents"],
      "Resource": "arn:aws:cloudformation:us-east-1:699191579533:stack/Groundwork/*"
    },
    {
      "Sid": "ReadGroundworkBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject"],
      "Resource": ["arn:aws:s3:::groundwork-*", "arn:aws:s3:::groundwork-*/*"]
    },
    {
      "Sid": "WatchRefreshJobs",
      "Effect": "Allow",
      "Action": ["sagemaker:DescribeProcessingJob", "sagemaker:ListProcessingJobs", "sagemaker:StopProcessingJob"],
      "Resource": "*"
    },
    {
      "Sid": "ReadRefreshJobLogs",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:699191579533:log-group:/aws/sagemaker/ProcessingJobs:*"
    }
  ]
}
